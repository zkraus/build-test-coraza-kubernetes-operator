
# UBI9 builder image
FROM registry.redhat.io/ubi9/go-toolset:latest AS builder

WORKDIR /opt/app-root/src

# go modules
COPY coraza-kubernetes-operator/go.mod go.mod
COPY coraza-kubernetes-operator/go.sum go.sum

# cache dependencies
RUN go mod download

# license
COPY coraza-kubernetes-operator/LICENSE /licenses/LICENSE

# Copy sources
COPY coraza-kubernetes-operator/cmd/ cmd/
COPY coraza-kubernetes-operator/api/ api/
# COPY coraza-kubernetes-operator/pkg/ pkg/
COPY coraza-kubernetes-operator/internal/ internal/

# cross compilation architecture
ARG TARGETARCH

# Build arguments
ARG GIT_SHA
ARG DIRTY
ARG CORAZA_KUBERNETES_OPERATOR_VERSION

ENV GIT_SHA=${GIT_SHA:-unknown}
ENV DIRTY=${DIRTY:-unknown}
ENV CORAZA_KUBERNETES_OPERATOR_VERSION=${CORAZA_KUBERNETES_OPERATOR_VERSION:-unknown}

RUN "whoami"

# Build
RUN echo "Building with CORAZA_KUBERNETES_OPERATOR_VERSION=${CORAZA_KUBERNETES_OPERATOR_VERSION}, GIT_SHA=${GIT_SHA}, DIRTY=${DIRTY}" &&\
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -a -o manager -tags no_fs_access ./cmd/manager


# Finalize image
FROM registry.redhat.io/ubi9/ubi-minimal:latest
ARG CORAZA_KUBERNETES_OPERATOR_VERSION
ENV CORAZA_KUBERNETES_OPERATOR_VERSION=${CORAZA_KUBERNETES_OPERATOR_VERSION:-unknown}

LABEL version="${CORAZA_KUBERNETES_OPERATOR_VERSION}" \
      summary="Web Application Firewall" \
      name="waf-1/waf-rhel9-operator" \
      # cpe
      description="WAF TODO" \
      io.k8s.display-name="Red Hat Web Application Firewall Operator metadata" \
      io.k8s.descrioption="Red Hat Web Application Firewall Operator" \
      io.openshift.expose-services="" \
      io.openshift.tags="api" \
      url="redat.com" \
      com.redhat.component="waf-operator" \
      vendor="Red Hat, Inc."

ENV OPERATOR_BINARY_NAME="manager" \
    USER_UID=1001 \
    USER_NAME=waf-operator

USER root

# install operator binary
COPY --from=builder /licenses/LICENSE /licenses/LICENSE
COPY --from=builder /opt/app-root/src/${OPERATOR_BINARY_NAME} /
# COPY --from=builder licenses/LICENSE /licenses/LICENSE
# COPY --from=builder licenses/LICENSE /licenses/LICENSE


RUN chown ${USER_UID} /${OPERATOR_BINARY_NAME}

USER ${USER_UID}

ENTRYPOINT [ "/manager" ]
